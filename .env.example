# ===========================================================================
# short-tale — copy to .env and fill in.   cp .env.example .env
# .env is gitignored. NEVER commit real values. NEVER put secrets in
# config/campaigns/*.yml — those ARE committed.
# ===========================================================================

# --- Reddit (required for the reddit source) -------------------------------
# Create a "script" app at https://www.reddit.com/prefs/apps
# Free tier is ~100 queries/min per client id — plenty for this tool.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive UA. Put your own contact/handle in it.
REDDIT_USER_AGENT=short-tale/0.1 by u/your_reddit_username

# --- Optional stock footage fallback ---------------------------------------
# Only needed if a campaign sets background.source to "pexels".
# Leave blank to stay fully offline.
PEXELS_API_KEY=

# --- Local model endpoints (no cloud, no keys) -----------------------------
OLLAMA_HOST=http://ollama:11434
# Any model you have pulled. 12GB VRAM comfortably fits a 14B at Q4.
# Swap freely: `docker compose exec ollama ollama pull <model>`
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
# Smaller/faster model used for cheap classification passes.
OLLAMA_MODEL_FAST=qwen2.5:7b-instruct-q4_K_M

# --- Speech ----------------------------------------------------------------
# kokoro (best quality) | piper (fastest, most forgiving) | auto
TTS_ENGINE=auto
TTS_VOICE=af_heart
# Whisper model used only for caption timing. tiny/base/small are plenty.
WHISPER_MODEL=base.en
WHISPER_DEVICE=auto

# --- Rendering -------------------------------------------------------------
# auto = use NVENC if the container can see it, else fall back to libx264.
VIDEO_ENCODER=auto
VIDEO_FPS=30

# --- App -------------------------------------------------------------------
# The review UI binds to localhost only by default. If you expose it to your
# LAN, set a token and it will be required for every mutating request.
APP_BIND=127.0.0.1
APP_PORT=8080
APP_TOKEN=
TZ=America/Chicago
LOG_LEVEL=INFO

# --- Publishing ------------------------------------------------------------
# Nothing is ever uploaded without an explicit approval in the review UI
# unless a campaign sets publish.mode: auto. There are no account passwords
# here by design — you sign in once, by hand, through the noVNC window.
PUBLISH_ENABLED=true
NOVNC_PORT=7900
